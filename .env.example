# ============================================================================
# Chatybot Environment Configuration Template
# Copy this file to .env or ~/.config/chatybot/.env and fill in your API keys:
#   cp .env.example .env
#
# Chatybot automatically loads .env files on startup.
# In chat_config.toml, the 'api_key' field specifies the NAME of the environment
# variable below (e.g. api_key = "MISTRAL_API_KEY"), keeping your secrets safe.
# ============================================================================

# Mistral AI (Default preset in chat_config.toml)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=""

# OpenAI (GPT-4o, o1, o3-mini, etc.)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# OpenRouter (Unified endpoint for Claude, Llama, DeepSeek, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Google Gemini (Gemini 2.5 Flash, Gemini 1.5 Pro via Google AI Studio)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# NVIDIA NIM / Build
# Get your key at: https://build.nvidia.com/
NVIDIA_API=""

# Groq (Ultra-fast inference for Llama 3, Mixtral)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=""

# DeepSeek
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=""

# Cohere
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""

# Hugging Face Inference
# Get your key at: https://huggingface.co/settings/tokens
HF_API_KEY=""

# Jina AI (Optional: for search & reranking tools)
# Get your key at: https://jina.ai/
JINA_API_KEY=""
