# ==============================================================================
# Sample ChatDSL: Testing the 10-level score limit in /decide
# The Jev decision model supports a maximum of 10 discrete rubric levels.
# ==============================================================================

/setvar text "The server CPU usage spiked to 98% and response latency exceeded 5 seconds."

# ------------------------------------------------------------------------------
# Example 1: Exceeding 10 levels using scale="1:20" (generates 20 levels: 1..20)
# Expected Output:
#   Error: score questions support at most 10 levels, got 20
# ------------------------------------------------------------------------------
/echo "Attempting score with scale='1:20' (20 levels)..."
/decide "$text" score "Rate severity from 1 to 20" scale="1:20" var=severity_score

# ------------------------------------------------------------------------------
# Example 2: Exceeding 10 levels using explicit levels= (12 levels)
# Expected Output:
#   Error: score questions support at most 10 levels, got 12
# ------------------------------------------------------------------------------
/echo "Attempting score with explicit levels (12 levels)..."
/decide "$text" score "Rate priority tier" levels="T1,T2,T3,T4,T5,T6,T7,T8,T9,T10,T11,T12" var=tier

# ------------------------------------------------------------------------------
# Example 3: Valid score scale within the limit (5 levels: 1..5)
# Evaluates successfully
# ------------------------------------------------------------------------------
/echo "Attempting valid score with scale='1:5' (5 levels)..."
/decide "$text" score "Rate incident severity" scale="1:5" var=valid_score
/echo "Evaluated score: ${valid_score}"
