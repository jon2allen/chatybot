# ============================================
# PHASE 3: Final Summary
# Load all comparison results and create comprehensive summary
# ============================================

# Batch 1: test1-test5
/filebank1 ${comparison_prefix}test1.txt
/filebank2 ${comparison_prefix}test2.txt
/filebank3 ${comparison_prefix}test3.txt
/filebank4 ${comparison_prefix}test4.txt
/filebank5 ${comparison_prefix}test5.txt

/model ${judge_model}
/multiline
Analyze these 5 comparison results for vision model accuracy.

Comparison 1 (test1):
{filebank1}

Comparison 2 (test2):
{filebank2}

Comparison 3 (test3):
{filebank3}

Comparison 4 (test4):
{filebank4}

Comparison 5 (test5):
{filebank5}

Count the total number of:
- subject_match: yes
- color_match: yes
- subject_match: partial
- color_match: partial
- subject_match: no
- color_match: no

Provide a summary of these 5 in this format:
Batch 1 (images 1-5):
Subject correct: X/5 (X%)
Color correct: Y/5 (Y%)
;;
/multiline
/save ${output_dir}/summary_batch1.txt
wait 2

# Batch 2: bird1-horse1
/filebank1 ${comparison_prefix}bird1.txt
/filebank2 ${comparison_prefix}cat1.txt
/filebank3 ${comparison_prefix}dog1.txt
/filebank4 ${comparison_prefix}elephant1.txt
/filebank5 ${comparison_prefix}horse1.txt

/model ${judge_model}
