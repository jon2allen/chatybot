# Test Script for Macro Expansion
# This script exercises all macros defined in macro.chatdsl

# Language expertise macros
%language_expert(python)
%language_comparison(java, csharp)
%language_learning_tips(rust)

# Code review and analysis macros
%code_review_language(javascript)
%code_explanation(python)
%debug_help(cpp, "segmentation fault", "process image data")

# Project and architecture macros
%system_design(microservices)
%api_specification(user_management)
%project_plan(ecommerce_platform)

# Documentation macros
%doc_template(api_endpoint)
%readme_template(open_source_library)
%changelog_entry(2.0.0, "Added new authentication module, fixed memory leaks, improved performance")

# Learning and tutorial macros
%tutorial_outline(machine_learning)
%cheatsheet(docker)
%interview_questions(react)

# Business and product macros
%business_plan(saas_product)
%product_specification(mobile_app)
%market_analysis(cloud_storage)

# Creative writing macros
%story_ideas(science_fiction)
%character_profile(John_Smith, detective)
%worldbuilding_guide(fantasy_kingdom)

# General purpose macros
%expert_prompt(quantum_computing)
%summary_request(research_paper)
%pros_cons_analysis(remote_work)

# Technical writing macros
%error_analysis(null_pointer_exception)
%performance_optimization(database_queries)
%security_analysis(web_application)

# Test with multiline command
/multiline
%language_expert(python)
%system_design(microservices)
%business_plan(saas_product)
;

# Test variable substitution with macros
set lang = "javascript"
%language_expert(${lang})

set tech = "kubernetes"
%expert_prompt(${tech})

# Test multiple macros in sequence
%language_comparison(python, java)
%code_review_language(${lang})
%performance_optimization(database)

# Test macros with special characters
%changelog_entry(1.5.2, "Fixed bug #123: $100 discount not applied, Added 20% performance improvement")
%pros_cons_analysis("work-from-home")

# End of test script